<?xml version="1.0" encoding="UTF-8"?>
<?import java.lang.String?>
<?import javafx.collections.FXCollections?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<HBox stylesheets="@styles.css" prefHeight="700.0" prefWidth="1200.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.controller.SessionController">
    <!-- Sidebar -->
    <VBox prefWidth="250.0" styleClass="sidebar" spacing="10">
        <Label text="Game Pilot" styleClass="sidebar-title" />
        
        <Region prefHeight="30" />
        
        <Button text="Formation" onAction="#navigateToFormation" styleClass="nav-btn" prefWidth="210"/>
        <Button text="Session" onAction="#navigateToSession" style="-fx-background-color: #7c3aed; -fx-text-fill: white;" styleClass="nav-btn" prefWidth="210"/>
        <Button text="Booking" onAction="#navigateToBooking" styleClass="nav-btn" prefWidth="210"/>
        <Button text="Evaluation" onAction="#navigateToEvaluation" styleClass="nav-btn" prefWidth="210"/>
        <Button text="Certification" onAction="#navigateToCertification" styleClass="nav-btn" prefWidth="210"/>
    </VBox>

    <!-- Main Content -->
    <HBox HBox.hgrow="ALWAYS" spacing="20" style="-fx-background-color: #161722; -fx-padding: 20;">
        
        <!-- Left Column: Table & Filters -->
        <VBox HBox.hgrow="ALWAYS" styleClass="card" spacing="15">
            <Label text="Sessions" styleClass="card-title"/>
            
            <TableView fx:id="sessionTable" VBox.vgrow="ALWAYS" styleClass="table-view">
                <columns>
                  <TableColumn fx:id="colId" prefWidth="40.0" text="ID" />
                  <TableColumn fx:id="colDateHeure" prefWidth="130.0" text="Date &amp; Heure" />
                  <TableColumn fx:id="colJeu" prefWidth="120.0" text="Jeu" />
                  <TableColumn fx:id="colPrix" prefWidth="70.0" text="Prix" />
                  <TableColumn fx:id="colDuree" prefWidth="70.0" text="Durée" />
                  <TableColumn fx:id="colCapacite" prefWidth="70.0" text="Capacité" />
                  <TableColumn fx:id="colType" prefWidth="90.0" text="Type" />
                  <TableColumn fx:id="colStatut" prefWidth="90.0" text="Statut" />
                </columns>
                 <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                 </columnResizePolicy>
            </TableView>
        </VBox>
        
        <!-- Right Column: Form -->
        <VBox prefWidth="350.0" styleClass="card" spacing="10">
            <Label text="Session Details" styleClass="card-title"/>
            <Label text="Select a record or create a new one." styleClass="card-subtitle"/>
            
            <HBox spacing="10">
                <VBox prefWidth="150" spacing="5">
                    <Label text="Date:" styleClass="label-white"/>
                    <DatePicker fx:id="datePicker" styleClass="date-picker"/>
                </VBox>
                <VBox prefWidth="150" spacing="5">
                    <Label text="Heure (HH:mm):" styleClass="label-white"/>
                    <TextField fx:id="timeField" promptText="14:30" styleClass="text-field"/>
                </VBox>
            </HBox>
            
            <Label text="Jeu:" styleClass="label-white"/>
            <TextField fx:id="jeuField" styleClass="text-field"/>
            
            <HBox spacing="10">
                <VBox prefWidth="150" spacing="5">
                    <Label text="Prix (€):" styleClass="label-white"/>
                    <TextField fx:id="prixField" styleClass="text-field"/>
                </VBox>
                <VBox prefWidth="150" spacing="5">
                    <Label text="Durée (min):" styleClass="label-white"/>
                    <TextField fx:id="dureeField" styleClass="text-field"/>
                </VBox>
            </HBox>
            
            <HBox spacing="10">
                <VBox prefWidth="150" spacing="5">
                    <Label text="Capacité Max:" styleClass="label-white"/>
                    <TextField fx:id="capaciteField" styleClass="text-field"/>
                </VBox>
                <VBox prefWidth="150" spacing="5">
                    <Label text="Type Session:" styleClass="label-white"/>
                    <ComboBox fx:id="typeCombo" styleClass="combo-box" prefWidth="150.0">
                        <items>
                            <FXCollections fx:factory="observableArrayList">
                                <String fx:value="individuel" />
                                <String fx:value="groupe" />
                                <String fx:value="atelier" />
                            </FXCollections>
                        </items>
                    </ComboBox>
                </VBox>
            </HBox>
            
            <HBox spacing="10">
                <VBox prefWidth="150" spacing="5">
                    <Label text="ID Coach:" styleClass="label-white"/>
                    <TextField fx:id="idCoachField" styleClass="text-field"/>
                </VBox>
                <VBox prefWidth="150" spacing="5">
                    <Label text="ID Formation:" styleClass="label-white"/>
                    <TextField fx:id="idFormationField" promptText="(Optionnel)" styleClass="text-field"/>
                </VBox>
            </HBox>

            <Label text="Statut:" styleClass="label-white"/>
            <ComboBox fx:id="statutCombo" prefWidth="310.0" styleClass="combo-box">
                <items>
                    <FXCollections fx:factory="observableArrayList">
                        <String fx:value="ouverte" />
                        <String fx:value="fermée" />
                        <String fx:value="annulée" />
                        <String fx:value="complète" />
                    </FXCollections>
                </items>
            </ComboBox>
            
            <Region prefHeight="10" />
            
            <HBox spacing="10">
                <Button text="Add" onAction="#handleAdd" styleClass="btn-update" prefWidth="100" prefHeight="35"/>
                <Button text="Update" onAction="#handleUpdate" styleClass="btn-update" prefWidth="100" prefHeight="35"/>
                <Button text="Delete" onAction="#handleDelete" styleClass="btn-delete" prefWidth="100" prefHeight="35"/>
            </HBox>
            
            <Button text="Clear Form" onAction="#handleReset" styleClass="btn-clear" prefWidth="320" prefHeight="35">
                <VBox.margin><Insets top="5"/></VBox.margin>
            </Button>
            
        </VBox>
        
    </HBox>
</HBox>

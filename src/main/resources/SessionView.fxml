<?xml version="1.0" encoding="UTF-8"?>
<?import java.lang.String?>
<?import javafx.collections.FXCollections?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<HBox stylesheets="@styles.css" prefHeight="700.0" prefWidth="1200.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.controller.SessionController">
    <!-- Sidebar -->
    <VBox prefWidth="250.0" styleClass="sidebar" spacing="10">
        <Label text="Game Pilot" styleClass="sidebar-title" />
        <Label text="ACADEMY MANAGER" styleClass="sidebar-subtitle" />
        <Region prefHeight="10" />
        <Button text="Formation" onAction="#navigateToFormation" styleClass="nav-btn" prefWidth="210"/>
        <Button text="Session" onAction="#navigateToSession" styleClass="nav-btn, active" prefWidth="210"/>
        <Button text="Booking" onAction="#navigateToBooking" styleClass="nav-btn" prefWidth="210"/>
        <Button text="Evaluation" onAction="#navigateToEvaluation" styleClass="nav-btn" prefWidth="210"/>
        <Button text="Certification" onAction="#navigateToCertification" styleClass="nav-btn" prefWidth="210"/>
    </VBox>

    <!-- Main Content -->
    <VBox HBox.hgrow="ALWAYS" style="-fx-background-color: #161722; -fx-padding: 30;" spacing="25">
        <VBox spacing="5">
            <Label text="Session Management" styleClass="card-title" />
            <Label text="Schedule and organize your live coaching sessions." styleClass="card-subtitle" />
        </VBox>

        <HBox spacing="25" VBox.vgrow="ALWAYS">
            <VBox HBox.hgrow="ALWAYS" styleClass="card" spacing="15">
                <HBox alignment="CENTER_LEFT" spacing="15">
                    <TextField promptText="Filter by game..." styleClass="text-field" prefWidth="250" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Button text="Refresh" onAction="#initialize" styleClass="btn-clear" />
                </HBox>
                
                <TableView fx:id="sessionTable" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colId" prefWidth="50.0" text="ID" />
                        <TableColumn fx:id="colJeu" prefWidth="120.0" text="Jeu" />
                        <TableColumn fx:id="colDateHeure" prefWidth="140.0" text="Date &amp; Heure" />
                        <TableColumn fx:id="colPrix" prefWidth="80.0" text="Prix (TND)" />
                        <TableColumn fx:id="colCapacite" prefWidth="80.0" text="Capacité" />
                        <TableColumn fx:id="colStatut" prefWidth="100.0" text="Statut" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>
            </VBox>

            <VBox prefWidth="380.0" styleClass="card" spacing="15">
                <Label text="Session Details" styleClass="card-title" style="-fx-font-size: 18;"/>
                
                <HBox spacing="15">
                    <VBox HBox.hgrow="ALWAYS" spacing="8">
                        <Label text="Date:" styleClass="label-white"/>
                        <DatePicker fx:id="datePicker" maxWidth="Infinity" styleClass="date-picker"/>
                    </VBox>
                    <VBox HBox.hgrow="ALWAYS" spacing="8">
                        <Label text="Heure (HH:mm):" styleClass="label-white"/>
                        <TextField fx:id="timeField" styleClass="text-field" promptText="14:30"/>
                    </VBox>
                </HBox>

                <VBox spacing="8">
                    <Label text="Jeu / Titre:" styleClass="label-white"/>
                    <TextField fx:id="jeuField" styleClass="text-field" promptText="ex: League of Legends"/>
                </VBox>

                <HBox spacing="15">
                    <VBox HBox.hgrow="ALWAYS" spacing="8">
                        <Label text="Prix (TND):" styleClass="label-white"/>
                        <TextField fx:id="prixField" styleClass="text-field"/>
                    </VBox>
                    <VBox HBox.hgrow="ALWAYS" spacing="8">
                        <Label text="Durée (min):" styleClass="label-white"/>
                        <TextField fx:id="dureeField" styleClass="text-field"/>
                    </VBox>
                </HBox>

                <HBox spacing="15">
                    <VBox HBox.hgrow="ALWAYS" spacing="8">
                        <Label text="Capacité Max:" styleClass="label-white"/>
                        <TextField fx:id="capaciteField" styleClass="text-field"/>
                    </VBox>
                    <VBox HBox.hgrow="ALWAYS" spacing="8">
                        <Label text="Type:" styleClass="label-white"/>
                        <ComboBox fx:id="typeCombo" maxWidth="Infinity" styleClass="combo-box">
                            <items>
                                <FXCollections fx:factory="observableArrayList">
                                    <String fx:value="individuel" />
                                    <String fx:value="groupe" />
                                </FXCollections>
                            </items>
                        </ComboBox>
                    </VBox>
                </HBox>

                <VBox spacing="8">
                    <Label text="Statut:" styleClass="label-white"/>
                    <ComboBox fx:id="statutCombo" maxWidth="Infinity" styleClass="combo-box">
                        <items>
                            <FXCollections fx:factory="observableArrayList">
                                <String fx:value="planifiée" />
                                <String fx:value="terminée" />
                                <String fx:value="annulée" />
                            </FXCollections>
                        </items>
                    </ComboBox>
                </VBox>

                <HBox spacing="15">
                    <VBox HBox.hgrow="ALWAYS" spacing="8">
                        <Label text="ID Coach:" styleClass="label-white"/>
                        <TextField fx:id="idCoachField" styleClass="text-field"/>
                    </VBox>
                    <VBox HBox.hgrow="ALWAYS" spacing="8">
                        <Label text="ID Formation:" styleClass="label-white"/>
                        <TextField fx:id="idFormationField" styleClass="text-field"/>
                    </VBox>
                </HBox>

                <Region VBox.vgrow="ALWAYS" />

                <HBox spacing="10">
                    <Button text="Add" onAction="#handleAdd" styleClass="btn-update" prefWidth="110" prefHeight="40"/>
                    <Button text="Update" onAction="#handleUpdate" styleClass="btn-secondary" prefWidth="110" prefHeight="40"/>
                    <Button text="Delete" onAction="#handleDelete" styleClass="btn-delete" prefWidth="110" prefHeight="40"/>
                </HBox>
                <Button text="Clear Fields" onAction="#handleReset" styleClass="btn-clear" maxWidth="Infinity" prefHeight="35"/>
            </VBox>
        </HBox>
    </VBox>
</HBox>

<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox stylesheets="@styles.css" prefHeight="700.0" prefWidth="1200.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.controller.AcademyMainController">
    <!-- Top Header -->
    <HBox styleClass="top-header">
        <Label text="🚀" styleClass="header-rocket" />
        <Region prefWidth="10" />
        <Label text="GAME PILOT ADMIN" styleClass="header-title" />
    </HBox>

    <!-- Navigation Tabs -->
    <HBox styleClass="nav-tabs-container">
        <Button text="DASHBOARD" onAction="#navigateToDashboard" styleClass="nav-tab, active" />
        <Button text="FORMATIONS" onAction="#navigateToFormation" styleClass="nav-tab" />
        <Button text="SESSIONS" onAction="#navigateToSession" styleClass="nav-tab" />
        <Button text="BOOKINGS" onAction="#navigateToBooking" styleClass="nav-tab" />
        <Button text="EVALUATIONS" onAction="#navigateToEvaluation" styleClass="nav-tab" />
        <Button text="CERTIFICATIONS" onAction="#navigateToCertification" styleClass="nav-tab" />
    </HBox>

    <!-- Main Content -->
    <VBox VBox.vgrow="ALWAYS" style="-fx-padding: 40;" spacing="30">
        <VBox alignment="CENTER" spacing="10">
            <Label text="🚀 Dashboard Académie 🚀" styleClass="card-title" style="-fx-font-size: 32;" />
            <Label text="Gérez vos programmes d'entraînement eSports depuis un seul endroit." styleClass="card-subtitle" />
        </VBox>

        <HBox spacing="30" alignment="CENTER">
            <!-- Summary Cards -->
            <VBox styleClass="dash-summary-card, cyan" prefWidth="280">
                <Label text="Total Formations" styleClass="dash-summary-label" />
                <Label text="23" styleClass="dash-summary-value" />
            </VBox>

            <VBox styleClass="dash-summary-card, purple" prefWidth="280">
                <Label text="Sessions Actives" styleClass="dash-summary-label" />
                <Label text="18" styleClass="dash-summary-value" />
            </VBox>

            <VBox styleClass="dash-summary-card, green" prefWidth="280">
                <Label text="Inscriptions" styleClass="dash-summary-label" />
                <Label text="145" styleClass="dash-summary-value" />
            </VBox>

            <VBox styleClass="dash-summary-card, purple" prefWidth="280" onMouseClicked="#navigateToVision" style="-fx-cursor: hand;">
                <Label text="LIVE COACHING" styleClass="dash-summary-label" />
                <Label text="Vision" styleClass="dash-summary-value" style="-fx-font-size: 24;" />
                <Label text="Rejoindre maintenant" style="-fx-text-fill: #00bcd4; -fx-font-size: 12;" />
            </VBox>
        </HBox>

        <Region VBox.vgrow="ALWAYS" />
        
        <HBox alignment="CENTER" spacing="20">
            <Button text=" Rafraîchir les statistiques" styleClass="btn-secondary" prefHeight="45" />
            <Button text="🚀 Passer au Mode Client (User)" onAction="#navigateToUserMode" styleClass="btn-primary" prefHeight="45" />
        </HBox>
    </VBox>
</VBox>


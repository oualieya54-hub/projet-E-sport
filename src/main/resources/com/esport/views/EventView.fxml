<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<!-- VBox is a simple container that stacks everything vertically -->
<VBox alignment="CENTER_LEFT" prefHeight="400.0" prefWidth="400.0" spacing="15.0" 
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="com.esport.controllers.EventController">
   
   <!-- Padding around the edges so it doesn't touch the window borders -->
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>

   <!-- Title Label -->
   <Label text="Create a New Event">
      <font>
         <Font name="System Bold" size="24.0" />
      </font>
   </Label>

   <Label text="Please fill out the details below:" />

   <!-- Input Fields linked to Controller using fx:id -->
   <VBox spacing="5.0">
      <Label text="Event Title:" />
      <TextField fx:id="titleInput" promptText="e.g., Summer Championship" />
   </VBox>

   <VBox spacing="5.0">
      <Label text="Game Name:" />
      <TextField fx:id="gameInput" promptText="e.g., Valorant" />
   </VBox>

   <VBox spacing="5.0">
      <Label text="Ticket Price ($):" />
      <TextField fx:id="priceInput" promptText="e.g., 25.50" />
   </VBox>

   <!-- Button linked to Controller using onAction -->
   <Button mnemonicParsing="false" onAction="#handleSaveEvent" text="Save Event" 
           style="-fx-background-color: #007bff; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 15;"/>

   <!-- Feedback Label to show success or error messages -->
   <Label fx:id="feedbackLabel" text="..." />

</VBox>

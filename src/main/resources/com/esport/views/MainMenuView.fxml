<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" prefHeight="500.0" prefWidth="400.0" spacing="25.0" 
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="com.esport.Controllers.MainMenuController"
      style="-fx-background-color: #f4f4f9;">
   
   <padding>
      <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
   </padding>

   <Label text="ESPORT MANAGER" textFill="#2c3e50">
      <font>
         <Font name="System Bold" size="32.0" />
      </font>
   </Label>
   
   <Label text="Main Menu Hub" textFill="#7f8c8d">
      <font>
         <Font size="16.0" />
      </font>
      <VBox.margin>
         <Insets bottom="20.0" top="-15.0" />
      </VBox.margin>
   </Label>

   <Button mnemonicParsing="false" onAction="#openEventWindow" prefHeight="50.0" prefWidth="250.0" 
           style="-fx-background-color: #007bff; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14px; -fx-cursor: hand;" 
           text="📅 Manage Events" />

   <Button mnemonicParsing="false" onAction="#openTournamentWindow" prefHeight="50.0" prefWidth="250.0" 
           style="-fx-background-color: #28a745; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14px; -fx-cursor: hand;" 
           text="🏆 Create Tournament" />

   <Button mnemonicParsing="false" onAction="#openMatchWindow" prefHeight="50.0" prefWidth="250.0" 
           style="-fx-background-color: #dc3545; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14px; -fx-cursor: hand;" 
           text="⚔️ Schedule Matches" />

   <Button mnemonicParsing="false" onAction="#openBetWindow" prefHeight="50.0" prefWidth="250.0" 
           style="-fx-background-color: #ffc107; -fx-text-fill: black; -fx-font-weight: bold; -fx-font-size: 14px; -fx-cursor: hand;" 
           text="💰 Place a Bet" />

</VBox>

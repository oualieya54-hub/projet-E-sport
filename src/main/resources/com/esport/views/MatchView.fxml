<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER_LEFT" prefHeight="450.0" prefWidth="400.0" spacing="15.0" 
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="com.esport.Controllers.MatchController">
   
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>

   <Label text="Schedule a Match">
      <font>
         <Font name="System Bold" size="24.0" />
      </font>
   </Label>

   <Label text="Enter the IDs to schedule a match:" />

   <VBox spacing="5.0">
      <Label text="Tournament ID:" />
      <TextField fx:id="tournamentIdInput" promptText="e.g., 1 (Must exist in DB!)" />
   </VBox>

   <VBox spacing="5.0">
      <Label text="Round Number:" />
      <TextField fx:id="roundInput" promptText="e.g., 1 for Quarter-Finals" />
   </VBox>

   <VBox spacing="5.0">
      <Label text="Team 1 ID:" />
      <TextField fx:id="team1IdInput" promptText="e.g., 101" />
   </VBox>

   <VBox spacing="5.0">
      <Label text="Team 2 ID:" />
      <TextField fx:id="team2IdInput" promptText="e.g., 102" />
   </VBox>

   <Button mnemonicParsing="false" onAction="#handleSaveMatch" text="Schedule Match" 
           style="-fx-background-color: #dc3545; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 15;"/>

   <Label fx:id="feedbackLabel" text="..." wrapText="true" />

</VBox>

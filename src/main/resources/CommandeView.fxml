<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.cell.PropertyValueFactory?>

<VBox spacing="10" style="-fx-padding: 20;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.controller.CommandeController">
    <Label text="Gestion des Commandes" styleClass="label-title"/>

    <HBox spacing="10">
        <Button fx:id="addButton" text="Nouvelle Commande"/>
        <Button fx:id="updateButton" text="Modifier Statut"/>
        <Button fx:id="paiementStripButton" text="Payer (Stripe)" onAction="#handlePaiementStripe"/>
        <Button fx:id="annulerRemboursementButton" text="Annuler &amp; Rembourser" onAction="#handleAnnulerAvecRemboursement" styleClass="button-danger"/>
    </HBox>

    <TableView fx:id="commandeTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn text="ID Cmd" prefWidth="60">
                <cellValueFactory><PropertyValueFactory property="idCommande" /></cellValueFactory>
            </TableColumn>
            <TableColumn text="ID User" prefWidth="60">
                <cellValueFactory><PropertyValueFactory property="idUser" /></cellValueFactory>
            </TableColumn>
            <TableColumn text="Total (€)" prefWidth="80">
                <cellValueFactory><PropertyValueFactory property="montantTotal" /></cellValueFactory>
            </TableColumn>
            <TableColumn text="Points Utilsés" prefWidth="100">
                <cellValueFactory><PropertyValueFactory property="pointsUtilises" /></cellValueFactory>
            </TableColumn>
            <TableColumn text="Statut" prefWidth="100">
                <cellValueFactory><PropertyValueFactory property="statut" /></cellValueFactory>
            </TableColumn>
            <TableColumn text="Date" prefWidth="150">
                <cellValueFactory><PropertyValueFactory property="dateCommande" /></cellValueFactory>
            </TableColumn>
            <TableColumn text="Adresse" prefWidth="200">
                <cellValueFactory><PropertyValueFactory property="adresseLivraison" /></cellValueFactory>
            </TableColumn>
        </columns>
    </TableView>
</VBox>

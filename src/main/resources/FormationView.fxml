<?xml version="1.0" encoding="UTF-8"?>
<?import java.lang.String?>
<?import javafx.collections.FXCollections?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<HBox stylesheets="@styles.css" prefHeight="700.0" prefWidth="1200.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.controller.FormationController">
    <!-- Sidebar -->
    <VBox prefWidth="250.0" styleClass="sidebar" spacing="10">
        <Label text="Game Pilot" styleClass="sidebar-title" />
        <Label text="ACADEMY MANAGER" styleClass="sidebar-subtitle" />
        
        <Region prefHeight="10" />
        
        <Button text="Formation" onAction="#navigateToFormation" styleClass="nav-btn, active" prefWidth="210"/>
        <Button text="Session" onAction="#navigateToSession" styleClass="nav-btn" prefWidth="210"/>
        <Button text="Booking" onAction="#navigateToBooking" styleClass="nav-btn" prefWidth="210"/>
        <Button text="Evaluation" onAction="#navigateToEvaluation" styleClass="nav-btn" prefWidth="210"/>
        <Button text="Certification" onAction="#navigateToCertification" styleClass="nav-btn" prefWidth="210"/>
    </VBox>

    <!-- Main Content -->
    <VBox HBox.hgrow="ALWAYS" style="-fx-background-color: #161722; -fx-padding: 30;" spacing="25">
        <VBox spacing="5">
            <Label text="Formation Management" styleClass="card-title" />
            <Label text="Create and manage your eSports training programs." styleClass="card-subtitle" />
        </VBox>

        <HBox spacing="25" VBox.vgrow="ALWAYS">
            <!-- Left Column: Table -->
            <VBox HBox.hgrow="ALWAYS" styleClass="card" spacing="15">
                <HBox alignment="CENTER_LEFT" spacing="15">
                    <TextField fx:id="searchField" promptText="Search titre..." styleClass="text-field" prefWidth="150" onKeyReleased="#handleFilter"/>
                    <ComboBox fx:id="filterJeuCombo" promptText="Jeu" styleClass="combo-box" prefWidth="100" onAction="#handleFilter"/>
                    <ComboBox fx:id="filterNiveauCombo" promptText="Niveau" styleClass="combo-box" prefWidth="100" onAction="#handleFilter">
                        <items>
                            <FXCollections fx:factory="observableArrayList">
                                <String fx:value="Tous" />
                                <String fx:value="débutant" />
                                <String fx:value="intermédiaire" />
                                <String fx:value="avancé" />
                            </FXCollections>
                        </items>
                    </ComboBox>
                    <ComboBox fx:id="filterStatutCombo" promptText="Statut" styleClass="combo-box" prefWidth="100" onAction="#handleFilter">
                        <items>
                            <FXCollections fx:factory="observableArrayList">
                                <String fx:value="Tous" />
                                <String fx:value="active" />
                                <String fx:value="archivée" />
                                <String fx:value="brouillon" />
                            </FXCollections>
                        </items>
                    </ComboBox>
                    <Region HBox.hgrow="ALWAYS" />
                    <Button text="Refresh" onAction="#handleRefresh" styleClass="btn-clear" />
                </HBox>
                
                <TableView fx:id="formationTable" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colId" prefWidth="50.0" text="ID" />
                        <TableColumn fx:id="colTitre" prefWidth="120.0" text="Titre" />
                        <TableColumn fx:id="colJeu" prefWidth="100.0" text="Jeu" />
                        <TableColumn fx:id="colNiveau" prefWidth="80.0" text="Niveau" />
                        <TableColumn fx:id="colPrix" prefWidth="70.0" text="Prix" />
                        <TableColumn fx:id="colStatut" prefWidth="80.0" text="Statut" />
                        <TableColumn fx:id="colDate" prefWidth="100.0" text="Date" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>
            </VBox>

            <!-- Right Column: Form -->
            <VBox prefWidth="380.0" styleClass="card" spacing="15">
                <Label text="Formation Details" styleClass="card-title" style="-fx-font-size: 18;"/>
                
                <VBox spacing="8">
                    <Label text="Titre de la Formation:" styleClass="label-white"/>
                    <TextField fx:id="titreField" styleClass="text-field" promptText="ex: Pro Coaching Valorant"/>
                </VBox>

                <VBox spacing="8">
                    <Label text="Description:" styleClass="label-white"/>
                    <TextArea fx:id="descArea" prefHeight="80.0" wrapText="true" styleClass="text-area" promptText="Détails de la formation..."/>
                </VBox>

                <HBox spacing="15">
                    <VBox HBox.hgrow="ALWAYS" spacing="8">
                        <Label text="Jeu:" styleClass="label-white"/>
                        <ComboBox fx:id="jeuCombo" maxWidth="Infinity" styleClass="combo-box"/>
                    </VBox>
                    <VBox HBox.hgrow="ALWAYS" spacing="8">
                        <Label text="Niveau:" styleClass="label-white"/>
                        <ComboBox fx:id="niveauCombo" maxWidth="Infinity" styleClass="combo-box">
                            <items>
                                <FXCollections fx:factory="observableArrayList">
                                    <String fx:value="débutant" />
                                    <String fx:value="intermédiaire" />
                                    <String fx:value="avancé" />
                                </FXCollections>
                            </items>
                        </ComboBox>
                    </VBox>
                </HBox>

                <HBox spacing="15">
                    <VBox HBox.hgrow="ALWAYS" spacing="8">
                        <Label text="Durée (sem):" styleClass="label-white"/>
                        <TextField fx:id="dureeField" styleClass="text-field"/>
                    </VBox>
                    <VBox HBox.hgrow="ALWAYS" spacing="8">
                        <Label text="Prix (TND):" styleClass="label-white"/>
                        <TextField fx:id="prixField" styleClass="text-field"/>
                    </VBox>
                </HBox>

                <HBox spacing="15">
                    <VBox HBox.hgrow="ALWAYS" spacing="8">
                        <Label text="Date Début:" styleClass="label-white"/>
                        <DatePicker fx:id="dateDebutPicker" maxWidth="Infinity" styleClass="date-picker"/>
                    </VBox>
                    <VBox HBox.hgrow="ALWAYS" spacing="8">
                        <Label text="Statut:" styleClass="label-white"/>
                        <ComboBox fx:id="statutCombo" maxWidth="Infinity" styleClass="combo-box">
                            <items>
                                <FXCollections fx:factory="observableArrayList">
                                    <String fx:value="brouillon" />
                                    <String fx:value="active" />
                                    <String fx:value="archivée" />
                                </FXCollections>
                            </items>
                        </ComboBox>
                    </VBox>
                </HBox>

                <VBox spacing="8">
                    <Label text="Nombre de Sessions:" styleClass="label-white"/>
                    <TextField fx:id="sessionsField" styleClass="text-field"/>
                </VBox>

                <Region VBox.vgrow="ALWAYS" />

                <HBox spacing="10">
                    <Button text="Add" onAction="#handleAdd" styleClass="btn-update" prefWidth="110" prefHeight="40"/>
                    <Button text="Update" onAction="#handleUpdate" styleClass="btn-secondary" prefWidth="110" prefHeight="40"/>
                    <Button text="Delete" onAction="#handleDelete" styleClass="btn-delete" prefWidth="110" prefHeight="40"/>
                </HBox>

                <Button text="Clear Fields" onAction="#handleReset" styleClass="btn-clear" maxWidth="Infinity" prefHeight="35"/>
            </VBox>
        </HBox>
    </VBox>
</HBox>

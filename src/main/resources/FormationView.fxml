<?xml version="1.0" encoding="UTF-8"?>
<?import java.lang.String?>
<?import javafx.collections.FXCollections?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<HBox stylesheets="@styles.css" prefHeight="700.0" prefWidth="1200.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.controller.FormationController">
    <!-- Sidebar -->
    <VBox prefWidth="250.0" styleClass="sidebar" spacing="10">
        <Label text="GAME PILOT" styleClass="sidebar-title"/>
        <Label text="MANAGER PRO" styleClass="sidebar-subtitle"/>
        
        <Region prefHeight="30" />
        
        <Button text="Home / Overview" styleClass="nav-btn" prefWidth="210"/>
        <Button text="Tournaments" styleClass="nav-btn" prefWidth="210"/>
        <Button text="Events" styleClass="nav-btn" prefWidth="210"/>
        <Button text="Matches" styleClass="nav-btn" prefWidth="210"/>
        <Button text="Formations" styleClass="nav-btn, active" prefWidth="210"/>
        <Button text="Sessions" styleClass="nav-btn" prefWidth="210"/>
        <Button text="Bets &amp; Odds" styleClass="nav-btn" prefWidth="210"/>
    </VBox>

    <!-- Main Content -->
    <HBox HBox.hgrow="ALWAYS" spacing="20" style="-fx-background-color: #161722; -fx-padding: 20;">
        
        <!-- Left Column: Table & Filters -->
        <VBox HBox.hgrow="ALWAYS" styleClass="card" spacing="15">
            <Label text="Formations" styleClass="card-title"/>
            
            <HBox spacing="10">
                <TextField fx:id="searchField" promptText="Rechercher par titre..." prefWidth="200" styleClass="text-field" />
                <ComboBox fx:id="filterJeuCombo" promptText="Jeu" prefWidth="120" styleClass="combo-box" />
                <ComboBox fx:id="filterNiveauCombo" promptText="Niveau" prefWidth="120" styleClass="combo-box">
                    <items>
                        <FXCollections fx:factory="observableArrayList">
                            <String fx:value="Tous" />
                            <String fx:value="débutant" />
                            <String fx:value="intermédiaire" />
                            <String fx:value="avancé" />
                        </FXCollections>
                    </items>
                </ComboBox>
                <ComboBox fx:id="filterStatutCombo" promptText="Statut" prefWidth="120" styleClass="combo-box">
                    <items>
                        <FXCollections fx:factory="observableArrayList">
                            <String fx:value="Tous" />
                            <String fx:value="active" />
                            <String fx:value="archivée" />
                            <String fx:value="brouillon" />
                        </FXCollections>
                    </items>
                </ComboBox>
                <Button text="Filtrer" onAction="#handleFilter" styleClass="btn-clear" />
                <Button text="Rafraîchir" onAction="#handleRefresh" styleClass="btn-clear" />
            </HBox>
            
            <TableView fx:id="formationTable" VBox.vgrow="ALWAYS" styleClass="table-view">
                <columns>
                  <TableColumn fx:id="colId" prefWidth="40.0" text="ID" />
                  <TableColumn fx:id="colTitre" prefWidth="120.0" text="Titre" />
                  <TableColumn fx:id="colJeu" prefWidth="90.0" text="Jeu" />
                  <TableColumn fx:id="colNiveau" prefWidth="90.0" text="Niveau" />
                  <TableColumn fx:id="colDuree" prefWidth="80.0" text="Durée" />
                  <TableColumn fx:id="colPrix" prefWidth="70.0" text="Prix" />
                  <TableColumn fx:id="colStatut" prefWidth="80.0" text="Statut" />
                  <TableColumn fx:id="colDate" prefWidth="90.0" text="Date" />
                </columns>
                 <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                 </columnResizePolicy>
            </TableView>
        </VBox>
        
        <!-- Right Column: Form -->
        <VBox prefWidth="350.0" styleClass="card" spacing="10">
            <Label text="Formation Details" styleClass="card-title"/>
            <Label text="Select a record or create a new one." styleClass="card-subtitle"/>
            
            <Label text="Titre:" styleClass="label-white"/>
            <TextField fx:id="titreField" styleClass="text-field"/>
            
            <Label text="Description:" styleClass="label-white"/>
            <TextArea fx:id="descArea" prefHeight="60.0" wrapText="true" styleClass="text-area"/>
            
            <Label text="Jeu:" styleClass="label-white"/>
            <ComboBox fx:id="jeuCombo" prefWidth="310.0" styleClass="combo-box"/>
            
            <Label text="Niveau:" styleClass="label-white"/>
            <ComboBox fx:id="niveauCombo" prefWidth="310.0" styleClass="combo-box">
                <items>
                    <FXCollections fx:factory="observableArrayList">
                        <String fx:value="débutant" />
                        <String fx:value="intermédiaire" />
                        <String fx:value="avancé" />
                    </FXCollections>
                </items>
            </ComboBox>
            
            <HBox spacing="10">
                <VBox prefWidth="150" spacing="5">
                    <Label text="Durée (sem):" styleClass="label-white"/>
                    <TextField fx:id="dureeField" styleClass="text-field"/>
                </VBox>
                <VBox prefWidth="150" spacing="5">
                    <Label text="Prix (€):" styleClass="label-white"/>
                    <TextField fx:id="prixField" styleClass="text-field"/>
                </VBox>
            </HBox>
            
            <Label text="Date Début:" styleClass="label-white"/>
            <DatePicker fx:id="dateDebutPicker" prefWidth="310.0" styleClass="date-picker"/>
            
            <HBox spacing="10">
                <VBox prefWidth="150" spacing="5">
                    <Label text="Statut:" styleClass="label-white"/>
                    <ComboBox fx:id="statutCombo" prefWidth="150.0" styleClass="combo-box">
                        <items>
                            <FXCollections fx:factory="observableArrayList">
                                <String fx:value="active" />
                                <String fx:value="archivée" />
                                <String fx:value="brouillon" />
                            </FXCollections>
                        </items>
                    </ComboBox>
                </VBox>
                <VBox prefWidth="150" spacing="5">
                    <Label text="Nb. Sessions:" styleClass="label-white"/>
                    <TextField fx:id="sessionsField" styleClass="text-field"/>
                </VBox>
            </HBox>
            
            <Region prefHeight="10" />
            
            <HBox spacing="10">
                <Button text="Add" onAction="#handleAdd" styleClass="btn-update" prefWidth="100" prefHeight="35"/>
                <Button text="Update" onAction="#handleUpdate" styleClass="btn-update" prefWidth="100" prefHeight="35"/>
                <Button text="Delete" onAction="#handleDelete" styleClass="btn-delete" prefWidth="100" prefHeight="35"/>
            </HBox>
            
            <Button text="Clear Form" onAction="#handleReset" styleClass="btn-clear" prefWidth="320" prefHeight="35">
                <VBox.margin><Insets top="5"/></VBox.margin>
            </Button>
            
        </VBox>
        
    </HBox>
</HBox>

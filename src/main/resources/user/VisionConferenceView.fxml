<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="750.0" prefWidth="1250.0" style="-fx-background-color: #0b121e;" stylesheets="@../styles.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.controller.user.VisionConferenceController">
    
    <!-- Top Bar -->
    <HBox alignment="CENTER_LEFT" prefHeight="70.0" spacing="20.0" style="-fx-background-color: #141c2b; -fx-padding: 0 20;">
        <Button onAction="#navigateBack" styleClass="btn-secondary" text="← Retour Dashboard" />
        <Label style="-fx-text-fill: white; -fx-font-size: 20; -fx-font-weight: bold;" text="ACADEMY LIVE : VISION CONFERENCE" />
        <Region HBox.hgrow="ALWAYS" />
        <HBox alignment="CENTER" spacing="10">
            <Circle fill="#00ff00" radius="5.0" stroke="BLACK" strokeType="INSIDE" />
            <Label style="-fx-text-fill: #b0b0b0;" text="Mode: Live Coaching" />
        </HBox>
    </HBox>

    <HBox VBox.vgrow="ALWAYS">
        <!-- Left Sidebar: My Sessions -->
        <VBox prefWidth="320.0" spacing="15.0" style="-fx-background-color: #0f1724; -fx-padding: 20;">
            <Label style="-fx-text-fill: white; -fx-font-size: 16; -fx-font-weight: bold;" text="Mes Sessions" />
            <ListView fx:id="sessionListView" VBox.vgrow="ALWAYS" styleClass="list-view-dark" />
            <VBox spacing="10">
                <Button maxWidth="Infinity" styleClass="btn-primary" text="Rejoindre la Session" onAction="#handleJoinSession" />
                <Button maxWidth="Infinity" styleClass="btn-danger" text="Annuler Réservation" />
            </VBox>
        </VBox>

        <!-- Main Conference Area -->
        <VBox HBox.hgrow="ALWAYS" spacing="15.0" style="-fx-padding: 20;">
            <!-- Live Status Bar -->
            <HBox alignment="CENTER_LEFT" spacing="15.0" style="-fx-background-color: #1a2332; -fx-padding: 10; -fx-background-radius: 10;">
                <Label fx:id="coachStatusLabel" style="-fx-text-fill: #00ff00; -fx-font-weight: bold;" text="● COACH ONLINE" />
                <Separator orientation="VERTICAL" prefHeight="20" />
                <Label fx:id="timerLabel" style="-fx-text-fill: white; -fx-font-family: 'Courier New';" text="00:45:12" />
                <Region prefWidth="20" />
                <Label style="-fx-background-color: #9c27b0; -fx-text-fill: white; -fx-padding: 3 10; -fx-background-radius: 5; -fx-font-size: 10;" text="SESSION ACTIVE" />
                <Region HBox.hgrow="ALWAYS" />
                <Label style="-fx-background-color: #e91e63; -fx-text-fill: white; -fx-padding: 3 10; -fx-background-radius: 15;" text="LIVE" />
            </HBox>

            <!-- Video Placeholder Area -->
            <StackPane VBox.vgrow="ALWAYS" style="-fx-background-color: #000000; -fx-background-radius: 15; -fx-border-color: #9c27b0; -fx-border-width: 2; -fx-border-radius: 15;">
                <VBox alignment="CENTER" spacing="20">
                    <Label text="📹" style="-fx-font-size: 80;" />
                    <Label text="Flux Vidéo du Coach (Slim)" style="-fx-text-fill: #b0b0b0; -fx-font-size: 18;" />
                </VBox>
                
                <!-- Bottom Controls Overlay -->
                <HBox alignment="CENTER" StackPane.alignment="BOTTOM_CENTER" spacing="15" style="-fx-padding: 20;">
                    <Button onAction="#handleCameraToggle" style="-fx-background-color: #333d4d; -fx-text-fill: white; -fx-background-radius: 50; -fx-min-width: 50; -fx-min-height: 50;" text="🎥" />
                    <Button onAction="#handleMicToggle" style="-fx-background-color: #333d4d; -fx-text-fill: white; -fx-background-radius: 50; -fx-min-width: 50; -fx-min-height: 50;" text="🎤" />
                    <Button onAction="#handleShareScreen" style="-fx-background-color: #333d4d; -fx-text-fill: white; -fx-background-radius: 50; -fx-min-width: 50; -fx-min-height: 50;" text="🖥️" />
                    <Button onAction="#handleLeaveSession" style="-fx-background-color: #f44336; -fx-text-fill: white; -fx-background-radius: 50; -fx-min-width: 50; -fx-min-height: 50;" text="❌" />
                </HBox>
            </StackPane>
        </VBox>

        <!-- Right Sidebar: Participants & Chat -->
        <VBox prefWidth="320.0" spacing="15.0" style="-fx-background-color: #0f1724; -fx-padding: 20;">
            <Label style="-fx-text-fill: white; -fx-font-size: 16; -fx-font-weight: bold;" text="Participants" />
            <ListView fx:id="participantsList" prefHeight="150.0" styleClass="list-view-dark" />
            
            <Separator opacity="0.1" />
            
            <Label style="-fx-text-fill: white; -fx-font-size: 16; -fx-font-weight: bold;" text="Chat Direct" />
            <ScrollPane VBox.vgrow="ALWAYS" fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;">
                <VBox fx:id="chatBox" spacing="10">
                    <Label text="Coach Slim: Bienvenue dans cette session !" style="-fx-text-fill: #00ff00; -fx-padding: 5; -fx-background-color: #1a2332; -fx-background-radius: 5;" wrapText="true" />
                </VBox>
            </ScrollPane>
            <HBox spacing="10">
                <TextField fx:id="chatInput" HBox.hgrow="ALWAYS" promptText="Tapez votre message..." onAction="#handleSendMessage" styleClass="text-field-dark" />
                <Button onAction="#handleSendMessage" styleClass="btn-primary" text="Envoyer" />
            </HBox>
        </VBox>
    </HBox>
</VBox>

<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="750.0" prefWidth="1200.0" style="-fx-background-color: #0b121e;" stylesheets="@../styles/styles.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.controller.user.VisionConferenceController">
    
    <!-- Top Bar -->
    <HBox alignment="CENTER_LEFT" prefHeight="60.0" spacing="20.0" style="-fx-background-color: #141c2b; -fx-padding: 0 20;">
        <Button onAction="#navigateBack" styleClass="btn-secondary" text="← Retour Dashboard" />
        <Label style="-fx-text-fill: white; -fx-font-size: 20; -fx-font-weight: bold;" text="VISION CONFERENCE : LIVE COACHING" />
        <Region HBox.hgrow="ALWAYS" />
        <Label fx:id="coachStatusLabel" style="-fx-text-fill: #b0b0b0;" text="COACH OFFLINE" />
    </HBox>

    <HBox VBox.vgrow="ALWAYS">
        <!-- Left: Reserved Sessions Table -->
        <VBox prefWidth="450.0" spacing="10.0" style="-fx-background-color: #0f1724; -fx-padding: 15;">
            <Label style="-fx-text-fill: #00bcd4; -fx-font-weight: bold;" text="MES RÉSERVATIONS" />
            <TableView fx:id="sessionTable" VBox.vgrow="ALWAYS" styleClass="table-view-dark">
                <columns>
                    <TableColumn fx:id="colJeu" text="Jeu" prefWidth="100" />
                    <TableColumn fx:id="colCoach" text="Coach" prefWidth="100" />
                    <TableColumn fx:id="colDate" text="Date" prefWidth="120" />
                    <TableColumn fx:id="colStatut" text="Statut" prefWidth="80" />
                </columns>
            </TableView>
        </VBox>

        <!-- Center: Active Session Info -->
        <VBox HBox.hgrow="ALWAYS" spacing="30.0" style="-fx-padding: 40;" alignment="TOP_CENTER">
            <VBox alignment="CENTER" spacing="15" style="-fx-background-color: #1a2332; -fx-padding: 30; -fx-background-radius: 20; -fx-border-color: #00bcd4; -fx-border-width: 2;">
                <Label fx:id="sessionTitleLabel" text="Sélectionnez une session pour commencer" style="-fx-text-fill: white; -fx-font-size: 24; -fx-font-weight: bold;" />
                <Label fx:id="activeCoachLabel" text="Coach: ---" style="-fx-text-fill: #b0b0b0; -fx-font-size: 18;" />
                
                <Separator opacity="0.1" maxWidth="300" />
                
                <Label fx:id="timerLabel" text="00:00:00" style="-fx-text-fill: #00bcd4; -fx-font-size: 48; -fx-font-family: 'Courier New'; -fx-font-weight: bold;" />
                
                <Label fx:id="sessionStatusBadge" text="SESSION INACTIVE" style="-fx-background-color: #333d4d; -fx-text-fill: white; -fx-padding: 5 15; -fx-background-radius: 5;" />
            </VBox>

            <Region VBox.vgrow="ALWAYS" />

            <!-- Action Bar -->
            <HBox spacing="20" alignment="CENTER">
                <Button onAction="#handleJoinSession" prefHeight="50" prefWidth="180" styleClass="btn-primary" text="🚀 REJOINDRE" />
                <Button onAction="#handleLeaveSession" prefHeight="50" prefWidth="180" styleClass="btn-danger" text="🛑 QUITTER" />
                <Button prefHeight="50" prefWidth="180" styleClass="btn-secondary" text="💬 OUVRIR CHAT" />
            </HBox>
        </VBox>

        <!-- Right: Chat Panel -->
        <VBox prefWidth="320.0" spacing="15.0" style="-fx-background-color: #0f1724; -fx-padding: 15;">
            <Label style="-fx-text-fill: #9c27b0; -fx-font-weight: bold;" text="CHAT EN DIRECT" />
            <ListView fx:id="chatListView" VBox.vgrow="ALWAYS" styleClass="list-view-dark" />
            <HBox spacing="10">
                <TextField fx:id="chatInput" HBox.hgrow="ALWAYS" promptText="Message..." onAction="#handleSendMessage" styleClass="text-field-dark" />
                <Button onAction="#handleSendMessage" styleClass="btn-primary" text="➤" />
            </HBox>
        </VBox>
    </HBox>
</VBox>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="600.0" prefWidth="850.0" stylesheets="@style.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.UserController">
    <children>
        <SplitPane dividerPositions="0.65" styleClass="root" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <items>
                <!-- Left side: Table -->
                <VBox spacing="10.0" styleClass="card">
                    <HBox alignment="CENTER_LEFT" spacing="15.0">
                        <Label styleClass="header-label" text="User Management" />
                        <Region HBox.hgrow="ALWAYS" />
                        <TextField fx:id="txtSearch" promptText="Search users..." />
                        <ComboBox fx:id="cbRoleFilter" promptText="Filter by Role" />
                    </HBox>
                    <TableView fx:id="userTable" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="colId" prefWidth="40.0" text="ID" />
                            <TableColumn fx:id="colNom" prefWidth="100.0" text="Nom" />
                            <TableColumn fx:id="colPseudo" prefWidth="100.0" text="Pseudo" />
                            <TableColumn fx:id="colRole" prefWidth="70.0" text="Role" />
                            <TableColumn fx:id="colBanned" prefWidth="60.0" text="Banned" />
                            <TableColumn fx:id="colLastActive" prefWidth="120.0" text="Last Active" />
                            <TableColumn fx:id="colBanAction" prefWidth="100.0" text="Action" />
                        </columns>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                        </columnResizePolicy>
                    </TableView>
                </VBox>
                
                <!-- Right side: Form -->
                <VBox spacing="15.0" styleClass="card">
                    <Label styleClass="header-label" style="-fx-font-size: 18px;" text="User Details" />
                    
                    <GridPane hgap="10" vgap="15">
                        <columnConstraints>
                            <ColumnConstraints minWidth="80.0" />
                            <ColumnConstraints hgrow="ALWAYS" />
                        </columnConstraints>
                        
                        <Label styleClass="muted-label" text="Nom:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                        <TextField fx:id="txtNom" promptText="Full Name" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                        
                        <Label styleClass="muted-label" text="Pseudo:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                        <TextField fx:id="txtPseudo" promptText="Username" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                        
                        <Label styleClass="muted-label" text="Email:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                        <TextField fx:id="txtEmail" promptText="user@example.com" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                        
                        <Label styleClass="muted-label" text="Role:" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                        <TextField fx:id="txtRole" promptText="Admin, Moderator" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                        
                        <Label styleClass="muted-label" text="Avatar URL:" GridPane.columnIndex="0" GridPane.rowIndex="4" />
                        <TextField fx:id="txtAvatarUrl" promptText="https://..." GridPane.columnIndex="1" GridPane.rowIndex="4" />
                    </GridPane>
                    
                    <Region VBox.vgrow="ALWAYS" />
                    
                    <VBox spacing="10.0">
                        <HBox alignment="CENTER" spacing="10.0">
                            <Button mnemonicParsing="false" onAction="#handleAddUser" prefWidth="80.0" styleClass="button-accent" text="Add" />
                            <Button mnemonicParsing="false" onAction="#handleUpdateUser" prefWidth="80.0" text="Update" />
                            <Button mnemonicParsing="false" onAction="#handleDeleteUser" prefWidth="80.0" styleClass="button-danger" text="Delete" />
                        </HBox>
                        <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#handleClear" styleClass="button-outline" text="Clear Form" />
                    </VBox>
                </VBox>
            </items>
        </SplitPane>
    </children>
</AnchorPane>

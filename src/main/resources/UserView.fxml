<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="600.0" prefWidth="850.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.UserController">
    <children>
        <SplitPane dividerPositions="0.65" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <items>
                <!-- Left side: Table -->
                <VBox spacing="10.0">
                    <padding>
                        <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                    </padding>
                    <Label style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #333333;" text="User Management" />
                    <TableView fx:id="userTable" VBox.vgrow="ALWAYS" stylesheets="@style.css">
                        <columns>
                            <TableColumn fx:id="colId" prefWidth="40.0" text="ID" />
                            <TableColumn fx:id="colNom" prefWidth="100.0" text="Nom" />
                            <TableColumn fx:id="colPseudo" prefWidth="100.0" text="Pseudo" />
                            <TableColumn fx:id="colEmail" prefWidth="150.0" text="Email" />
                            <TableColumn fx:id="colRole" prefWidth="70.0" text="Role" />
                            <TableColumn fx:id="colPoints" prefWidth="60.0" text="Points" />
                            <TableColumn fx:id="colBanned" prefWidth="60.0" text="Banned" />
                        </columns>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                        </columnResizePolicy>
                    </TableView>
                </VBox>
                
                <!-- Right side: Form -->
                <VBox spacing="15.0" style="-fx-background-color: #f9f9f9;">
                    <padding>
                        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                    </padding>
                    <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #333333;" text="User Details" />
                    
                    <GridPane hgap="10" vgap="15">
                        <columnConstraints>
                            <ColumnConstraints minWidth="80.0" />
                            <ColumnConstraints hgrow="ALWAYS" />
                        </columnConstraints>
                        
                        <Label text="Nom:" GridPane.rowIndex="0" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                        <TextField fx:id="txtNom" promptText="Full Name" GridPane.rowIndex="0" GridPane.columnIndex="1" />
                        
                        <Label text="Pseudo:" GridPane.rowIndex="1" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                        <TextField fx:id="txtPseudo" promptText="Username" GridPane.rowIndex="1" GridPane.columnIndex="1" />
                        
                        <Label text="Email:" GridPane.rowIndex="2" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                        <TextField fx:id="txtEmail" promptText="user@example.com" GridPane.rowIndex="2" GridPane.columnIndex="1" />
                        
                        <Label text="Password:" GridPane.rowIndex="3" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                        <PasswordField fx:id="txtPassword" promptText="Leave blank to keep current" GridPane.rowIndex="3" GridPane.columnIndex="1" />
                        
                        <Label text="Role:" GridPane.rowIndex="4" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                        <TextField fx:id="txtRole" promptText="player, admin, etc." GridPane.rowIndex="4" GridPane.columnIndex="1" />
                        
                        <Label text="Avatar URL:" GridPane.rowIndex="5" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                        <TextField fx:id="txtAvatarUrl" promptText="https://example.com/avatar.png" GridPane.rowIndex="5" GridPane.columnIndex="1" />
                    </GridPane>
                    
                    <Region VBox.vgrow="ALWAYS" />
                    
                    <VBox spacing="10.0">
                        <HBox spacing="10.0" alignment="CENTER">
                            <Button mnemonicParsing="false" onAction="#handleAddUser" text="Add" prefWidth="80.0" style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" />
                            <Button mnemonicParsing="false" onAction="#handleUpdateUser" text="Update" prefWidth="80.0" style="-fx-background-color: #2196F3; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" />
                            <Button mnemonicParsing="false" onAction="#handleDeleteUser" text="Delete" prefWidth="80.0" style="-fx-background-color: #f44336; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" />
                        </HBox>
                        <Button mnemonicParsing="false" onAction="#handleClear" text="Clear Form" maxWidth="Infinity" style="-fx-background-color: #e0e0e0; -fx-font-weight: bold; -fx-cursor: hand;" />
                    </VBox>
                </VBox>
            </items>
        </SplitPane>
    </children>
</AnchorPane>

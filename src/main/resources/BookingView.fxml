<?xml version="1.0" encoding="UTF-8"?>
<?import java.lang.String?>
<?import javafx.collections.FXCollections?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<HBox stylesheets="@styles.css" prefHeight="700.0" prefWidth="1200.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.controller.BookingController">
    <!-- Sidebar -->
    <VBox prefWidth="250.0" styleClass="sidebar" spacing="10">
        <Label text="Game Pilot" styleClass="sidebar-title" />
        <Label text="ACADEMY MANAGER" styleClass="sidebar-subtitle" />
        <Region prefHeight="10" />
        <Button text="Formation" onAction="#navigateToFormation" styleClass="nav-btn" prefWidth="210"/>
        <Button text="Session" onAction="#navigateToSession" styleClass="nav-btn" prefWidth="210"/>
        <Button text="Booking" onAction="#navigateToBooking" styleClass="nav-btn, active" prefWidth="210"/>
        <Button text="Evaluation" onAction="#navigateToEvaluation" styleClass="nav-btn" prefWidth="210"/>
        <Button text="Certification" onAction="#navigateToCertification" styleClass="nav-btn" prefWidth="210"/>
    </VBox>

    <!-- Main Content -->
    <VBox HBox.hgrow="ALWAYS" style="-fx-background-color: #161722; -fx-padding: 30;" spacing="25">
        <VBox spacing="5">
            <Label text="Booking Management" styleClass="card-title" />
            <Label text="Track student enrollments and payment statuses." styleClass="card-subtitle" />
        </VBox>

        <HBox spacing="25" VBox.vgrow="ALWAYS">
            <VBox HBox.hgrow="ALWAYS" styleClass="card" spacing="15">
                <TableView fx:id="bookingTable" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colIdBooking" prefWidth="60.0" text="ID" />
                        <TableColumn fx:id="colIdSession" prefWidth="100.0" text="ID Session" />
                        <TableColumn fx:id="colIdEleve" prefWidth="100.0" text="ID Elève" />
                        <TableColumn fx:id="colStatutPaiement" prefWidth="130.0" text="Statut" />
                        <TableColumn fx:id="colModePaiement" prefWidth="130.0" text="Mode" />
                        <TableColumn fx:id="colDateReservation" prefWidth="140.0" text="Date" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>
            </VBox>

            <VBox prefWidth="380.0" styleClass="card" spacing="15">
                <Label text="Booking Details" styleClass="card-title" style="-fx-font-size: 18;"/>
                
                <HBox spacing="15">
                    <VBox HBox.hgrow="ALWAYS" spacing="8">
                        <Label text="ID Session:" styleClass="label-white"/>
                        <TextField fx:id="idSessionField" styleClass="text-field"/>
                    </VBox>
                    <VBox HBox.hgrow="ALWAYS" spacing="8">
                        <Label text="ID Elève:" styleClass="label-white"/>
                        <TextField fx:id="idEleveField" styleClass="text-field"/>
                    </VBox>
                </HBox>

                <VBox spacing="8">
                    <Label text="Date Réservation:" styleClass="label-white"/>
                    <DatePicker fx:id="dateReservationPicker" maxWidth="Infinity" styleClass="date-picker"/>
                </VBox>

                <VBox spacing="8">
                    <Label text="Statut Paiement:" styleClass="label-white"/>
                    <ComboBox fx:id="statutPaiementCombo" maxWidth="Infinity" styleClass="combo-box">
                        <items>
                            <FXCollections fx:factory="observableArrayList">
                                <String fx:value="en_attente" />
                                <String fx:value="confirmé" />
                                <String fx:value="annulé" />
                            </FXCollections>
                        </items>
                    </ComboBox>
                </VBox>

                <VBox spacing="8">
                    <Label text="Mode de Paiement:" styleClass="label-white"/>
                    <ComboBox fx:id="modePaiementCombo" maxWidth="Infinity" styleClass="combo-box">
                        <items>
                            <FXCollections fx:factory="observableArrayList">
                                <String fx:value="carte" />
                                <String fx:value="virement" />
                                <String fx:value="espèces" />
                                <String fx:value="gratuit" />
                            </FXCollections>
                        </items>
                    </ComboBox>
                </VBox>

                <Region VBox.vgrow="ALWAYS" />

                <HBox spacing="10">
                    <Button text="Add" onAction="#handleAdd" styleClass="btn-update" prefWidth="110" prefHeight="40"/>
                    <Button text="Update" onAction="#handleUpdate" styleClass="btn-secondary" prefWidth="110" prefHeight="40"/>
                    <Button text="Delete" onAction="#handleDelete" styleClass="btn-delete" prefWidth="110" prefHeight="40"/>
                </HBox>
                <Button text="Clear Fields" onAction="#handleReset" styleClass="btn-clear" maxWidth="Infinity" prefHeight="35"/>
            </VBox>
        </HBox>
    </VBox>
</HBox>

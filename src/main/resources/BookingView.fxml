<?xml version="1.0" encoding="UTF-8"?>
<?import java.lang.String?>
<?import javafx.collections.FXCollections?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<HBox stylesheets="@styles.css" prefHeight="700.0" prefWidth="1200.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.controller.BookingController">
    <!-- Sidebar -->
    <VBox prefWidth="250.0" styleClass="sidebar" spacing="10">
        <Label text="Game Pilot" styleClass="sidebar-title" />
        
        <Region prefHeight="30" />
        
        <Button text="Formation" styleClass="nav-btn" prefWidth="210"/>
        <Button text="Session" styleClass="nav-btn" prefWidth="210"/>
        <Button text="Booking" style="-fx-background-color: #7c3aed; -fx-text-fill: white;" styleClass="nav-btn" prefWidth="210"/>
        <Button text="Evaluation" styleClass="nav-btn" prefWidth="210"/>
        <Button text="Certification" styleClass="nav-btn" prefWidth="210"/>
    </VBox>

    <!-- Main Content -->
    <HBox HBox.hgrow="ALWAYS" spacing="20" style="-fx-background-color: #161722; -fx-padding: 20;">
        
        <!-- Left Column: Table & Filters -->
        <VBox HBox.hgrow="ALWAYS" styleClass="card" spacing="15">
            <Label text="Bookings" styleClass="card-title"/>
            
            <TableView fx:id="bookingTable" VBox.vgrow="ALWAYS" styleClass="table-view">
                <columns>
                  <TableColumn fx:id="colIdBooking" prefWidth="50.0" text="ID" />
                  <TableColumn fx:id="colIdSession" prefWidth="80.0" text="ID Session" />
                  <TableColumn fx:id="colIdEleve" prefWidth="80.0" text="ID Elève" />
                  <TableColumn fx:id="colStatutPaiement" prefWidth="120.0" text="Statut Paiement" />
                  <TableColumn fx:id="colDateReservation" prefWidth="120.0" text="Date Réservation" />
                  <TableColumn fx:id="colModePaiement" prefWidth="120.0" text="Mode Paiement" />
                </columns>
                 <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                 </columnResizePolicy>
            </TableView>
        </VBox>
        
        <!-- Right Column: Form -->
        <VBox prefWidth="350.0" styleClass="card" spacing="10">
            <Label text="Booking Details" styleClass="card-title"/>
            <Label text="Select a record or create a new one." styleClass="card-subtitle"/>
            
            <HBox spacing="10">
                <VBox prefWidth="150" spacing="5">
                    <Label text="ID Session:" styleClass="label-white"/>
                    <TextField fx:id="idSessionField" styleClass="text-field"/>
                </VBox>
                <VBox prefWidth="150" spacing="5">
                    <Label text="ID Elève:" styleClass="label-white"/>
                    <TextField fx:id="idEleveField" styleClass="text-field"/>
                </VBox>
            </HBox>
            
            <Label text="Date Réservation:" styleClass="label-white"/>
            <DatePicker fx:id="dateReservationPicker" prefWidth="310.0" styleClass="date-picker"/>
            
            <Label text="Statut Paiement:" styleClass="label-white"/>
            <ComboBox fx:id="statutPaiementCombo" prefWidth="310.0" styleClass="combo-box">
                <items>
                    <FXCollections fx:factory="observableArrayList">
                        <String fx:value="en_attente" />
                        <String fx:value="confirmé" />
                        <String fx:value="annulé" />
                    </FXCollections>
                </items>
            </ComboBox>
            
            <Label text="Mode de Paiement:" styleClass="label-white"/>
            <ComboBox fx:id="modePaiementCombo" prefWidth="310.0" styleClass="combo-box">
                <items>
                    <FXCollections fx:factory="observableArrayList">
                        <String fx:value="carte" />
                        <String fx:value="virement" />
                        <String fx:value="espèces" />
                        <String fx:value="gratuit" />
                    </FXCollections>
                </items>
            </ComboBox>
            
            <Region prefHeight="10" />
            
            <HBox spacing="10">
                <Button text="Add" onAction="#handleAdd" styleClass="btn-update" prefWidth="100" prefHeight="35"/>
                <Button text="Update" onAction="#handleUpdate" styleClass="btn-update" prefWidth="100" prefHeight="35"/>
                <Button text="Delete" onAction="#handleDelete" styleClass="btn-delete" prefWidth="100" prefHeight="35"/>
            </HBox>
            
            <Button text="Clear Form" onAction="#handleReset" styleClass="btn-clear" prefWidth="320" prefHeight="35">
                <VBox.margin><Insets top="5"/></VBox.margin>
            </Button>
            
        </VBox>
        
    </HBox>
</HBox>

<?xml version="1.0" encoding="UTF-8"?>
<?import java.lang.String?>
<?import javafx.collections.FXCollections?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<HBox stylesheets="@styles.css" prefHeight="700.0" prefWidth="1200.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.controller.EvaluationController">
    <!-- Sidebar -->
    <VBox prefWidth="250.0" styleClass="sidebar" spacing="10">
        <Label text="Game Pilot" styleClass="sidebar-title" />
        <Label text="ACADEMY MANAGER" styleClass="sidebar-subtitle" />
        <Region prefHeight="10" />
        <Button text="Formation" onAction="#navigateToFormation" styleClass="nav-btn" prefWidth="210"/>
        <Button text="Session" onAction="#navigateToSession" styleClass="nav-btn" prefWidth="210"/>
        <Button text="Booking" onAction="#navigateToBooking" styleClass="nav-btn" prefWidth="210"/>
        <Button text="Evaluation" onAction="#navigateToEvaluation" styleClass="nav-btn, active" prefWidth="210"/>
        <Button text="Certification" onAction="#navigateToCertification" styleClass="nav-btn" prefWidth="210"/>
    </VBox>

    <!-- Main Content -->
    <VBox HBox.hgrow="ALWAYS" style="-fx-background-color: #161722; -fx-padding: 30;" spacing="25">
        <VBox spacing="5">
            <Label text="Evaluation Management" styleClass="card-title" />
            <Label text="Review student performance and provide feedback." styleClass="card-subtitle" />
        </VBox>

        <HBox spacing="25" VBox.vgrow="ALWAYS">
            <VBox HBox.hgrow="ALWAYS" styleClass="card" spacing="15">
                <TableView fx:id="evaluationTable" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colIdEvaluation" prefWidth="60.0" text="ID" />
                        <TableColumn fx:id="colIdBooking" prefWidth="100.0" text="ID Booking" />
                        <TableColumn fx:id="colNote" prefWidth="80.0" text="Note" />
                        <TableColumn fx:id="colCommentaire" prefWidth="250.0" text="Commentaire" />
                        <TableColumn fx:id="colDateEval" prefWidth="120.0" text="Date" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>
            </VBox>

            <VBox prefWidth="380.0" styleClass="card" spacing="15">
                <Label text="Evaluation Details" styleClass="card-title" style="-fx-font-size: 18;"/>
                
                <VBox spacing="8">
                    <Label text="ID Booking:" styleClass="label-white"/>
                    <TextField fx:id="idBookingField" styleClass="text-field"/>
                </VBox>

                <VBox spacing="8">
                    <Label text="Note (0-100):" styleClass="label-white"/>
                    <TextField fx:id="noteField" styleClass="text-field"/>
                </VBox>

                <VBox spacing="8">
                    <Label text="Commentaire:" styleClass="label-white"/>
                    <TextArea fx:id="commentaireArea" prefHeight="120.0" wrapText="true" styleClass="text-area" promptText="Feedback pour l'élève..."/>
                </VBox>

                <VBox spacing="8">
                    <Label text="Date Evaluation:" styleClass="label-white"/>
                    <DatePicker fx:id="dateEvalPicker" maxWidth="Infinity" styleClass="date-picker"/>
                </VBox>

                <Region VBox.vgrow="ALWAYS" />

                <HBox spacing="10">
                    <Button text="Add" onAction="#handleAdd" styleClass="btn-update" prefWidth="110" prefHeight="40"/>
                    <Button text="Update" onAction="#handleUpdate" styleClass="btn-secondary" prefWidth="110" prefHeight="40"/>
                    <Button text="Delete" onAction="#handleDelete" styleClass="btn-delete" prefWidth="110" prefHeight="40"/>
                </HBox>
                <Button text="Clear Fields" onAction="#handleReset" styleClass="btn-clear" maxWidth="Infinity" prefHeight="35"/>
            </VBox>
        </HBox>
    </VBox>
</HBox>
